{
    "name": "yashjawale/wordpress-plugin-template",
    "license": "GPL-3.0-only",
    "description": "A starter WordPress plugin template to serve as starting point in creating a custom plugin",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "WordPressPluginTemplate\\": "includes/"
        },
        "classmap": [
            "includes/classes/",
            "includes/traits/"
        ]
    },
    "scripts": {
        "lint:php": "phpcs",
        "lint:php:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "authors": [
        {
            "name": "yashjawale",
            "email": "connect@yashjawale.in"
        }
    ]
}
