{
  "name": "wordpress-plugin-template",
  "version": "1.0.0",
  "private": true,
  "description": "Front-end asset tooling for the WordPress Plugin Template",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "start": "wp-scripts start --blocks-manifest --source-path=assets/src --output-path=assets/build",
    "build": "npm run typecheck && wp-scripts build --blocks-manifest --source-path=assets/src --output-path=assets/build",
    "typecheck": "tsc --noEmit",
    "test:unit": "wp-scripts test-unit-js",
    "test:unit:watch": "wp-scripts test-unit-js --watch",
    "lint:js": "wp-scripts lint-js assets/src",
    "lint:css": "wp-scripts lint-style 'assets/src/**/*.scss'"
  },
  "lint-staged": {
    "*.php": "./vendor/bin/phpcs",
    "*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
    "*.{css,scss}": "wp-scripts lint-style"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/scripts": "^36.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
