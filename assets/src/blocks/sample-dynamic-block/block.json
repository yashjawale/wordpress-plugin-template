{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wordpress-plugin-template/sample-dynamic-block",
	"version": "1.0.0",
	"title": "Sample Dynamic Block",
	"category": "text",
	"icon": "smiley",
	"description": "A sample block rendered on the server.",
	"textdomain": "wordpress-plugin-template",
	"attributes": {
		"content": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.tsx",
	"viewScript": "file:./view.ts",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
