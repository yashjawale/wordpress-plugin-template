{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wordpress-plugin-template/sample-static-block",
	"version": "1.0.0",
	"title": "Sample Static Block",
	"category": "text",
	"icon": "format-aside",
	"description": "A sample block saved as static markup.",
	"textdomain": "wordpress-plugin-template",
	"attributes": {
		"content": {
			"type": "string",
			"source": "html",
			"selector": "p",
			"default": ""
		}
	},
	"editorScript": "file:./index.tsx",
	"viewScript": "file:./view.ts",
	"style": "file:./style-index.css"
}
